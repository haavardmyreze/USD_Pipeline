{
  "name": "markdown-viewer",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:firefox-extension": "node ./scripts/build-firefox-extension.mjs",
    "package:firefox-extension": "npm run build:firefox-extension && node ./scripts/package-firefox-extension.mjs",
    "sign:firefox-extension": "npm run build:firefox-extension && node ./scripts/sign-firefox-extension.mjs",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "papaparse": "^5.5.4",
    "pdfjs-dist": "^6.1.200",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "oxlint": "^1.69.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.0",
    "web-ext": "^8.9.0"
  }
}
